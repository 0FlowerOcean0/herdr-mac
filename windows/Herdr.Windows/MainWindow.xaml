<Window
    x:Class="Herdr.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Herdr">

    <Grid x:Name="RootGrid" Background="#181825">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="#20202E">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="9" Margin="14,0,0,0">
                <Image Source="Assets/HerdrLogoMark.svg" Width="20" Height="20" />
                <TextBlock Text="herdr" FontFamily="Consolas" FontWeight="SemiBold" FontSize="16" Foreground="#CDD6F4" VerticalAlignment="Center" />
                <Border Background="#313244" CornerRadius="4" Padding="7,2">
                    <TextBlock Text="WINDOWS PREVIEW" FontSize="10" FontWeight="SemiBold" Foreground="#A6ADC8" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2" Margin="0,0,142,0">
                <TextBlock x:Name="StatusText" Text="正在连接…" FontSize="12" Foreground="#A6ADC8" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button x:Name="FolderButton" ToolTipService.ToolTip="选择工作目录" Click="FolderButton_Click" Style="{StaticResource SubtleButtonStyle}" Width="36" Height="34">
                    <FontIcon Glyph="&#xE8B7;" FontSize="15" />
                </Button>
                <Button x:Name="ReconnectButton" ToolTipService.ToolTip="重新连接 Herdr" Click="ReconnectButton_Click" Style="{StaticResource SubtleButtonStyle}" Width="36" Height="34">
                    <FontIcon Glyph="&#xE72C;" FontSize="15" />
                </Button>
                <Button x:Name="SettingsButton" ToolTipService.ToolTip="设置" Click="SettingsButton_Click" Style="{StaticResource SubtleButtonStyle}" Width="36" Height="34">
                    <FontIcon Glyph="&#xE713;" FontSize="15" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <WebView2 x:Name="TerminalWebView" DefaultBackgroundColor="#181825" />

            <Border x:Name="EmptyState" Background="#181825" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Spacing="12">
                    <Image Source="Assets/HerdrLogoMark.svg" Width="56" Height="56" Opacity="0.85" />
                    <TextBlock x:Name="EmptyTitle" Text="没有找到 Herdr" FontSize="22" FontWeight="SemiBold" Foreground="#CDD6F4" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyMessage" TextWrapping="Wrap" TextAlignment="Center" Foreground="#A6ADC8" FontSize="14" />
                    <Button Content="打开设置" Click="SettingsButton_Click" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
